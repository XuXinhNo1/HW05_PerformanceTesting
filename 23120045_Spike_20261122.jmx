<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23120045_Spike_20261122">
      <stringProp name="TestPlan.comments">Spike Testing with Dual Workload: Sudden Order Processing Spike + Lockout</stringProp>
